# Copy to .env (or set in your shell / Vercel project settings).
# Required in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Set to true for local development only.
DJANGO_DEBUG=false
# Optional: extra hostnames (comma separated), e.g. a custom domain. *.vercel.app is always allowed.
DJANGO_ALLOWED_HOSTS=
# Optional: TMDB v3 API key or v4 read access token, for posters and IMDb links.
# Without it the app still works and shows placeholder posters.
TMDB_API_KEY=
